	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--on-surface)"
		},
		"border": {
			"radius": "0"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--32)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--32)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--on-surface)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.1"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--hero)",
					"fontWeight": "700",
					"letterSpacing": "-0.05em",
					"lineHeight": "0.9"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--section)",
					"fontWeight": "700",
					"letterSpacing": "-0.04em",
					"lineHeight": "1"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--card)",
					"fontWeight": "700",
					"letterSpacing": "-0.03em",
					"lineHeight": "1.1"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--quote)",
					"fontWeight": "700"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--eyebrow)",
					"fontWeight": "700",
					"letterSpacing": "0.4em",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--on-surface-variant)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-container)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				}
			},
			"button": {
				"border": {
					"radius": "0",
					"style": "none",
					"width": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--primary-container)",
					"text": "var(--wp--preset--color--on-primary-container)"
				},
				"shadow": "var(--wp--preset--shadow--button)",
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--16)",
						"right": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--16)",
						"left": "var(--wp--preset--spacing--40)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--on-primary)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--on-primary)"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--on-primary)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--on-surface-variant)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--eyebrow)"
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "0"
				},
				"variations": {
					"outline": {
						"border": {
							"color": "color-mix(in srgb, var(--wp--preset--color--outline) 20%, transparent)",
							"radius": "0",
							"style": "solid",
							"width": "1px"
						},
						"color": {
							"background": "var(--wp--preset--color--surface-container-high)",
							"text": "var(--wp--preset--color--primary)"
						},
						"shadow": "none",
						":hover": {
							"border": {
								"color": "color-mix(in srgb, var(--wp--preset--color--primary) 40%, transparent)"
							},
							"color": {
								"background": "var(--wp--preset--color--surface-bright)",
								"text": "var(--wp--preset--color--primary)"
							}
						}
					}
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--16)"
				}
			},
			"core/group": {
				"border": {
					"radius": "0"
				}
			},
			"core/cover": {
				"border": {
					"radius": "0"
				}
			},
			"core/image": {
				"border": {
					"radius": "0"
				}
			},
			"core/site-title": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontSize": "var(--wp--preset--font-size--card)",
					"fontWeight": "700",
					"letterSpacing": "-0.05em",
					"textTransform": "uppercase"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--primary)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--on-surface)"
							}
						}
					}
				}
			},
			"core/navigation": {
				"color": {
					"text": "var(--wp--preset--color--on-surface-variant)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em",
					"textTransform": "uppercase"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--on-surface-variant)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary-container)"
							}
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"background": "transparent"
				},
				"border": {
					"color": "transparent",
					"width": "0"
				}
			}
		}
	}
